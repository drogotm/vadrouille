# Copie ce fichier en `.env` (ignoré par git) et remplis les valeurs.
# ⚠️ Tout ce qui commence par EXPO_PUBLIC_ est embarqué dans l'app : n'y mets AUCUN secret.

# --- Supabase (Dashboard > Project Settings > API) ---
# URL du projet, ex. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Clé publique (format sb_publishable_... ou ancienne clé "anon"). Jamais la clé service_role / secret.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Web & liens d'invitation ---
# URL publique où est hébergée la version web (export Expo). Sert à construire les liens
# d'invitation https://.../i/<code> et les universal links iOS.
EXPO_PUBLIC_WEB_URL=
# Lien App Store affiché aux invités web après leur réponse (vide = bouton masqué).
EXPO_PUBLIC_APP_STORE_URL=

# --- Mode démo ---
# 1 = force le mode démo (backend local simulé, aucune donnée envoyée). Si les variables
# Supabase sont vides, l'app passe automatiquement en mode démo.
EXPO_PUBLIC_DEMO_MODE=

# --- Secrets serveur (Edge Functions) : NE PAS les mettre ici ---
# À définir côté Supabase uniquement :
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...      (optionnel : rédaction des explications)
#   npx supabase secrets set CLAUDE_MODEL=claude-haiku-5-5      (optionnel)
# En local, ils vont dans supabase/functions/.env (ignoré par git).
